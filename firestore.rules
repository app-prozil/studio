rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // The admin's Firebase Auth UID. This is the most secure way to identify the admin.
      return isSignedIn() && request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
    }

    function isOwner(userId) {
      // Check if the requesting user is the owner of the document.
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isTeacher() {
      // Check if the requesting user has a profile in the /teachers collection.
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isDirector() {
      // Check if the requesting user has a profile in the /directors collection.
      return isSignedIn() && exists(/databases/$(database)/documents/directors/$(request.auth.uid));
    }

    function isTaskAuthor(task) {
      // Check if the requesting user is the teacher who created the task.
      return request.auth.uid == task.teacherId;
    }

    function isStudentUpdatingPerformance() {
      // The user must be the student assigned to the task
      if (request.auth.uid != resource.data.studentId) {
        return false;
      }

      // A student cannot un-complete a task that is already marked as complete
      if (resource.data.isCompleted == true && request.resource.data.isCompleted == false) {
        return false;
      }

      // The core properties of the task must not change.
      // This ensures a student cannot change the task itself, only their performance data.
      if (request.resource.data.title != resource.data.title ||
          request.resource.data.description != resource.data.description ||
          request.resource.data.dueDate != resource.data.dueDate ||
          request.resource.data.teacherId != resource.data.teacherId ||
          request.resource.data.studentId != resource.data.studentId ||
          request.resource.data.subject != resource.data.subject ||
          request.resource.data.taskType != resource.data.taskType ||
          request.resource.data.studentName != resource.data.studentName ||
          request.resource.data.teacherName != resource.data.teacherName ||
          request.resource.data.studentProzilId != resource.data.studentProzilId
        ) {
        return false;
      }
      
      // If all checks pass, allow the update.
      // This implicitly allows updates to 'isCompleted', 'completedAt', 'totalTime', and 'questions'.
      return true;
    }


    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    
    // This rule is specifically for the collection group query used by directors/admins
    // to view all tasks across the system. It only allows LIST operations.
    // GET operations on individual tasks are still governed by the more specific nested rules.
    match /{path=**}/tasks/{taskId} {
      allow list: if isAdmin() || isDirector();
    }

    match /teachers/{teacherId} {
      // READ: Any signed-in user can read teacher profiles. This is necessary for
      // students to find their teacher's ProZil ID during signup.
      // Admins and directors can also read.
      allow get: if isSignedIn();

      // LIST: Admins and directors can list all teachers.
      allow list: if isAdmin() || isDirector();
      
      // WRITE: A user can create/update/delete their OWN teacher profile. 
      // An admin can write to ANY teacher profile.
      allow write: if isOwner(teacherId) || isAdmin();

      // --- Nested Teacher Collections ---
      match /exercises/{exerciseId} {
        // Teachers can manage their own exercise bank. Admins have full access. Directors can read.
        allow read: if isOwner(teacherId) || isAdmin() || isDirector();
        allow write: if isOwner(teacherId) || isAdmin();
      }

      match /tasks/{taskId} {
        // Teachers can manage tasks they have created. Admins have full access.
        // Students can update their own performance data on the teacher's copy of the task.
        // Directors can read all tasks.
        allow read: if isOwner(teacherId) || isAdmin() || isDirector();
        allow create, delete: if isOwner(teacherId) || isAdmin();
        allow update: if isOwner(teacherId) || isAdmin() || isStudentUpdatingPerformance();
      }
    }

    match /students/{studentId} {
      // GET: A student can read their own profile. A teacher can read their own students' profiles. Admins and directors can read all.
      allow get: if isOwner(studentId) || (isTeacher() && request.auth.uid in resource.data.teacherIds) || isAdmin() || isDirector();
      
      // LIST: Admins and directors can list/query for students.
      allow list: if isAdmin() || isDirector();
      
      // WRITE: A user can create/update/delete their OWN student profile. Admins can do anything.
      allow write: if isOwner(studentId) || isAdmin();

      // --- Nested Student Collections ---
      match /tasks/{taskId} {
        // GET: A student can get their own task. The authoring teacher can get the task. Admins and directors can get any.
        allow get: if isOwner(studentId) || isTaskAuthor(resource.data) || isAdmin() || isDirector();
        
        // LIST: A student can list their own tasks. Admins and directors can list tasks for any student.
        allow list: if isOwner(studentId) || isAdmin() || isDirector();
        
        // CREATE: A teacher or admin can create a task for a student.
        allow create: if isTeacher() || isAdmin();
        
        // UPDATE: The student can update their performance data. The authoring teacher can edit the task. Admins can do anything.
        allow update: if isOwner(studentId) || isTaskAuthor(resource.data) || isAdmin();
                         
        // DELETE: The authoring teacher or an admin can delete a task.
        allow delete: if isTaskAuthor(resource.data) || isAdmin();
      }
    }

    match /directors/{directorId} {
      // READ: Any signed-in user can read a director's profile.
      allow get: if isSignedIn();
      // LIST: Admins and directors can list all directors.
      allow list: if isAdmin() || isDirector();
      // WRITE: A user can manage their OWN director profile. Admin can manage any.
      allow write: if isOwner(directorId) || isAdmin();
    }
    
    match /invites/{inviteId} {
      // Allow the signup page to query for an email.
      allow list: if true;
      // Only admins can create/delete invites.
      allow write: if isAdmin();
      // No one needs to read single docs or update them.
      allow get, update: if false;
    }
  }
}
