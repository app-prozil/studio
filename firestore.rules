rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    //  HELPER FUNCTIONS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Role Checks ---
    function isAdmin() {
      // The admin is a superuser with a hardcoded, unique UID.
      return isSignedIn() && request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
    }

    function isTeacher() {
      // The admin user is also a teacher, so this check should pass for them without a DB read.
      if (isAdmin()) {
        return true;
      }
      // For other users, check if a teacher document exists.
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isDirector() {
      // The admin user is NOT a director. This check should fail fast for them without a DB read.
      if (isAdmin()) {
        return false;
      }
      // For other users, check if a director document exists.
      return isSignedIn() && exists(/databases/$(database)/documents/directors/$(request.auth.uid));
    }

    // --- Data Ownership & Relationship Checks ---

    function isTaskAuthor(task) {
      // Checks if the requesting user is the teacher who created the task.
      return isSignedIn() && request.auth.uid == task.teacherId;
    }

    function isStudentUpdatingPerformance() {
      // Only the assigned student can update their own performance data.
      // They cannot change core task properties.
      if (request.auth.uid != resource.data.studentId) {
        return false;
      }
      if (resource.data.isCompleted == true && request.resource.data.isCompleted == false) {
        return false; // Cannot un-complete a task
      }
      // List of immutable fields for a student
      let immutableFields = ['title', 'description', 'dueDate', 'teacherId', 'studentId', 'subject', 'taskType', 'studentName', 'teacherName', 'studentProzilId'];
      return request.resource.data.diff(resource.data).affectedKeys().toSet().intersection(immutableFields.toSet()).size() == 0;
    }


    // =====================================================================
    //  COLLECTION RULES
    // =====================================================================

    // --- Collection Group Query for Tasks ---
    // Allows directors and admins to view all tasks across the system.
    match /{path=**}/tasks/{taskId} {
      allow list: if isAdmin() || isDirector();
    }

    // --- Teacher Profiles and Data ---
    match /teachers/{teacherId} {
      // Anyone can read basic teacher profiles.
      allow get: if isSignedIn();
      // Only admins and directors can list all teachers.
      allow list: if isAdmin() || isDirector();
      // A teacher can manage their own profile. Admin has full rights.
      allow write: if isOwner(teacherId) || isAdmin();

      // Subcollection: Teacher's Exercise Bank
      match /exercises/{exerciseId} {
        // Teacher can manage their own bank. Admins/Directors can read.
        allow read: if isOwner(teacherId) || isAdmin() || isDirector();
        allow write: if isOwner(teacherId) || isAdmin();
      }

      // Subcollection: Master copy of tasks created by the teacher.
      match /tasks/{taskId} {
        // Teacher can manage their own tasks. Admin/Directors can read.
        allow read: if isOwner(teacherId) || isAdmin() || isDirector();
        allow create, delete: if isOwner(teacherId) || isAdmin();
        // A teacher can update their own task. A student can update their performance data. Admin has full rights.
        allow update: if isOwner(teacherId) || isAdmin() || isStudentUpdatingPerformance();
      }
    }

    // --- Student Profiles and Data ---
    match /students/{studentId} {
      // A student can read their own profile.
      // A teacher can read profiles of their linked students.
      // Admins and directors can read any student profile.
      allow get: if isOwner(studentId) || (isTeacher() && request.auth.uid in resource.data.teacherIds) || isAdmin() || isDirector();
      // Only admins can list ALL students directly.
      allow list: if isAdmin();
      // A student can manage their own profile. Admin has full rights.
      allow write: if isOwner(studentId) || isAdmin();

      // Subcollection: Copy of tasks assigned to the student.
      match /tasks/{taskId} {
        // Student can read their own task. The authoring teacher can also read it. Admin/Directors can read any.
        allow get: if isOwner(studentId) || isTaskAuthor(resource.data) || isAdmin() || isDirector();
        // A student can list their own tasks. Admins/Directors can list tasks for any student.
        allow list: if isOwner(studentId) || isAdmin() || isDirector();
        // A teacher or admin can create a task for a student.
        allow create: if isTeacher() || isAdmin();
        // Student can update their performance. Teacher can edit the task. Admin can do anything.
        allow update: if isOwner(studentId) || isTaskAuthor(resource.data) || isAdmin();
        // Authoring teacher or admin can delete a task.
        allow delete: if isTaskAuthor(resource.data) || isAdmin();
      }
    }

    // --- Director Profiles ---
    match /directors/{directorId} {
      // Anyone can read a director profile. This avoids circular dependencies with isDirector().
      allow get: if isSignedIn();
      // ONLY the admin can get a list of all directors.
      allow list: if isAdmin();
      // A director can manage their own profile. Admin has full rights.
      allow write: if isOwner(directorId) || isAdmin();
    }

    // --- User Invitations ---
    match /invites/{inviteId} {
      // The signup page needs to query invites by email, so list is public.
      allow list: if true;
      // Reading a single invite document is not needed.
      allow get: if false;
      // Only admins can create, update, or delete invites.
      allow write: if isAdmin();
    }
  }
}
