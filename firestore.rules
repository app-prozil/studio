rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Collection Group Query for Tasks ---
    // Permite que diretores gerem relatórios e que o admin tenha acesso total.
    match /{path=**}/tasks/{taskId} {
      allow list: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || exists(/databases/$(database)/documents/directors/$(request.auth.uid));
    }

    // --- Teacher Profiles and Data ---
    match /teachers/{teacherId} {
      // Admin pode ler qualquer perfil; outros usuários logados também.
      allow get: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth != null;
      // Admin e diretores podem listar professores.
      allow list: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || exists(/databases/$(database)/documents/directors/$(request.auth.uid));
      // Admin ou o próprio professor podem escrever.
      allow write: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == teacherId;

      // Subcollection: Teacher's Exercise Bank
      match /exercises/{exerciseId} {
        // Admin, o dono, ou um diretor podem ler.
        allow read: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == teacherId || exists(/databases/$(database)/documents/directors/$(request.auth.uid));
        // Admin ou o dono podem escrever.
        allow write: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == teacherId;
      }

      // Subcollection: Master copy of tasks created by the teacher.
      match /tasks/{taskId} {
        // Admin, o dono, ou um diretor podem ler.
        allow read: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == teacherId || exists(/databases/$(database)/documents/directors/$(request.auth.uid));
        // Admin ou o dono podem criar/deletar.
        allow create, delete: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == teacherId;
        // Admin, o dono, ou o aluno podem atualizar.
        allow update: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == teacherId || request.auth.uid == resource.data.studentId;
      }
    }

    // --- Student Profiles and Data ---
    match /students/{studentId} {
      // Admin, o dono, ou um professor vinculado podem ler.
      allow get: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == studentId || (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && resource.data.teacherIds.hasAny([request.auth.uid]));
      // Admin ou um professor podem listar alunos.
      allow list: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
      // Admin ou o dono podem escrever.
      allow write: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == studentId;

      // Subcollection: Copy of tasks assigned to the student.
      match /tasks/{taskId} {
        // Admin, o dono, o autor, ou um diretor podem ler.
        allow get: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == studentId || request.auth.uid == resource.data.teacherId || exists(/databases/$(database)/documents/directors/$(request.auth.uid));
        // Admin ou o dono podem listar suas próprias tarefas.
        allow list: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == studentId;
        // Admin ou um professor podem criar tarefas.
        allow create: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
        // Admin, o dono, ou o autor podem atualizar.
        allow update: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == studentId || request.auth.uid == resource.data.teacherId;
        // Admin ou o autor podem deletar.
        allow delete: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == resource.data.teacherId;
      }
    }

    // --- Director Profiles ---
    match /directors/{directorId} {
      // Admin pode ler; outros usuários logados também.
      allow get: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth != null;
      // APENAS admin pode listar diretores.
      allow list: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
      // Admin ou o próprio dono podem escrever.
      allow write: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.uid == directorId;
    }

    // --- User Invitations ---
    match /invites/{inviteId} {
      // Qualquer um pode listar, para a página de signup verificar convites.
      allow list: if true;
      // Ninguém precisa ler um convite individual.
      allow get: if false;
      // APENAS admin pode criar convites.
      allow create: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
      // Admin pode deletar, ou o usuário consumindo o convite.
      allow delete: if request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1' || request.auth.token.email == resource.data.email;
      // Invites não devem ser atualizados.
      allow update: if false;
    }
  }
}
