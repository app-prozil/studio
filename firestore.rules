rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    //  HELPER FUNCTIONS
    // =====================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // The admin is a superuser with a hardcoded, unique UID.
      return request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
    }

    // Correctly checks if a user is a Teacher.
    // For Admin, it returns true immediately to avoid DB reads and permission spirals.
    function isTeacher(userId) {
      if (isAdmin()) { return true; } // Admin is treated as a teacher.
      return exists(/databases/$(database)/documents/teachers/$(userId));
    }

    // Correctly checks if a user is a Director.
    // For Admin, it returns false immediately to avoid DB reads and permission spirals.
    function isDirector(userId) {
      if (isAdmin()) { return false; } // Admin is NOT a director.
      return exists(/databases/$(database)/documents/directors/$(userId));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isTaskAuthor(task) {
      return isSignedIn() && request.auth.uid == task.teacherId;
    }
    
    function isStudentUpdatingPerformance() {
      // Rule: Student must be the one the task is assigned to.
      if (request.auth.uid != resource.data.studentId) {
        return false;
      }
      // Rule: Cannot un-complete a task.
      if (resource.data.isCompleted == true && request.resource.data.isCompleted == false) {
        return false;
      }
      // Rule: Students can only update their performance fields, not the core task definition.
      let immutableFields = ['title', 'description', 'dueDate', 'teacherId', 'studentId', 'subject', 'taskType', 'studentName', 'teacherName', 'studentProzilId'];
      return request.resource.data.diff(resource.data).affectedKeys().toSet().intersection(immutableFields.toSet()).size() == 0;
    }

    // =====================================================================
    //  RULES - Admin access is explicitly added to each relevant rule.
    // =====================================================================

    // --- Collection Group Query for Tasks ---
    // This allows Directors to generate reports across all tasks.
    match /{path=**}/tasks/{taskId} {
      allow list: if isDirector(request.auth.uid) || isAdmin();
    }

    // --- Teacher Profiles and Data ---
    match /teachers/{teacherId} {
      // Anyone can view a teacher's public profile.
      allow get: if isSignedIn();
      // Directors and Admin can list all teachers.
      allow list: if isDirector(request.auth.uid) || isAdmin();
      // Only the owner or an Admin can write to a teacher's profile.
      allow write: if isOwner(teacherId) || isAdmin();

      // Subcollection: Teacher's Exercise Bank
      match /exercises/{exerciseId} {
        // The owner, directors, or an admin can read exercises.
        allow read: if isOwner(teacherId) || isDirector(request.auth.uid) || isAdmin();
        // Only the owner or an admin can create/edit/delete exercises.
        allow write: if isOwner(teacherId) || isAdmin();
      }

      // Subcollection: Master copy of tasks created by the teacher.
      match /tasks/{taskId} {
        // The owner, directors, or an admin can read the master task.
        allow read: if isOwner(teacherId) || isDirector(request.auth.uid) || isAdmin();
        // The owner or an admin can create/delete master tasks.
        allow create, delete: if isOwner(teacherId) || isAdmin();
        // The owner, admin, or the assigned student (for performance) can update.
        allow update: if isOwner(teacherId) || isStudentUpdatingPerformance() || isAdmin();
      }
    }

    // --- Student Profiles and Data ---
    match /students/{studentId} {
      // The owner, linked teachers, or an admin can get a student's profile.
      allow get: if isOwner(studentId) || (isTeacher(request.auth.uid) && resource.data.teacherIds.hasAny([request.auth.uid])) || isAdmin();
      // Teachers and admin can list students. Client-side query must be secure.
      allow list: if isTeacher(request.auth.uid) || isAdmin();
      // Only the owner or an admin can write to a student's profile.
      allow write: if isOwner(studentId) || isAdmin();

      // Subcollection: Copy of tasks assigned to the student.
      match /tasks/{taskId} {
        // The owner, the task author, directors, or an admin can get the task.
        allow get: if isOwner(studentId) || isTaskAuthor(resource.data) || isDirector(request.auth.uid) || isAdmin();
        // Only the owner or an admin can list their own tasks.
        allow list: if isOwner(studentId) || isAdmin();
        // Teachers or admins can assign (create) tasks.
        allow create: if isTeacher(request.auth.uid) || isAdmin();
        // The owner, author, or admin can update the task copy.
        allow update: if isOwner(studentId) || isTaskAuthor(resource.data) || isAdmin();
        // The author or admin can delete the task copy.
        allow delete: if isTaskAuthor(resource.data) || isAdmin();
      }
    }

    // --- Director Profiles ---
    match /directors/{directorId} {
      // Anyone signed in can view a director's public profile.
      allow get: if isSignedIn();
      // Directors and Admin can list all directors.
      // The helper function isDirector() will prevent the admin from causing a recursive read.
      allow list: if isDirector(request.auth.uid) || isAdmin();
      // Only the owner or an admin can write to a director's profile.
      allow write: if isOwner(directorId) || isAdmin();
    }

    // --- User Invitations ---
    match /invites/{inviteId} {
      // Publicly listable so the signup page can check if an email is invited.
      allow list: if true;
      // No one needs to read a single invite directly.
      allow get: if false;
      // Only admin can create/delete invites.
      allow write: if isAdmin();
    }
  }
}