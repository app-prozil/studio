rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      // Is the requesting user the owner of the document?
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Is the requesting user the designated administrator?
      return isSignedIn() && request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
    }
    
    function isTeacher() {
      // Does the requesting user have a profile in the /teachers collection?
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isTaskAuthor(task) {
      // Is the requesting user the teacher who created the task?
      return request.auth.uid == task.teacherId;
    }

    // --- Data Validation Functions ---

    function isValidTeacherProfile(profileData, userId) {
      // On create, the profile ID must match the user's auth UID.
      return profileData.id == userId;
    }

    function isTeacherProfileUpdateValid() {
      // When updating, the core ID cannot be changed.
      return request.resource.data.id == resource.data.id;
    }

    function isValidStudentProfile(profileData, userId) {
      // On create, profile ID must match auth UID and have a teacher linked.
      return profileData.id == userId && profileData.teacherId is string;
    }

    function isStudentProfileUpdateValid() {
      // When updating, the student's ID and assigned teacher ID cannot change.
      let isIdImmutable = request.resource.data.id == resource.data.id;
      let isTeacherIdImmutable = request.resource.data.teacherId == resource.data.teacherId;
      return isIdImmutable && isTeacherIdImmutable;
    }

    function isValidNewExercise(exerciseData, teacherId, exerciseId) {
      // On create, IDs must be consistent.
      return exerciseData.teacherId == teacherId && exerciseData.id == exerciseId;
    }

    function isExerciseUpdateValid() {
      // When updating, core IDs cannot change.
      return request.resource.data.id == resource.data.id &&
             request.resource.data.teacherId == resource.data.teacherId;
    }
    
    function isValidNewTeacherTask(taskData, teacherId) {
      // On create, teacherId must match and task must have questions.
      return taskData.teacherId == teacherId && taskData.questions.size() > 0;
    }
    
    function isValidNewStudentTask(taskData, studentId) {
       // On create, the task must be for the correct student,
       // authored by the requesting teacher, and have questions.
      return taskData.studentId == studentId &&
             taskData.teacherId == request.auth.uid &&
             taskData.questions.size() > 0;
    }

    function canStudentUpdateTask(incoming, existing) {
      // A student cannot update an already completed task.
      if (existing.isCompleted) {
        return false;
      }
      // A student can only update their performance data and mark the task as complete.
      // All other metadata must remain the same.
      let isMetadataUnchanged = 
            incoming.id == existing.id &&
            incoming.title == existing.title &&
            incoming.teacherId == existing.teacherId &&
            incoming.studentId == existing.studentId &&
            incoming.studentProzilId == existing.studentProzilId &&
            incoming.teacherName == existing.teacherName &&
            incoming.studentName == existing.studentName &&
            incoming.subject == existing.subject &&
            incoming.description == existing.description &&
            incoming.taskType == existing.taskType &&
            incoming.dueDate == existing.dueDate;
            
      // The questions array can change, but we don't validate the specifics here for simplicity.
      // The incoming `isCompleted` can be true or false (student marking it done).
      return isMetadataUnchanged;
    }
    
    function canTeacherUpdateTask(incoming, existing) {
      // A teacher can update most fields of a task they authored,
      // but cannot change the core student/teacher assignment.
      return isTaskAuthor(existing) &&
             incoming.id == existing.id &&
             incoming.teacherId == existing.teacherId &&
             incoming.studentId == existing.studentId;
    }

    // -------------------------------------------------------------------------
    // Global Admin Override Rule
    // This rule is checked first and grants the admin full access everywhere.
    // -------------------------------------------------------------------------
    
    match /{path=**} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection Rules (for non-admin users)
    // -------------------------------------------------------------------------

    match /teachers/{teacherId} {
      // Anyone logged in can read teacher profiles (needed for student sign-up).
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      // A user can only create, update, or delete their own teacher profile.
      allow create: if isOwner(teacherId) && isValidTeacherProfile(request.resource.data, teacherId);
      allow update: if isOwner(teacherId) && isTeacherProfileUpdateValid();
      allow delete: if isOwner(teacherId);

      // --- Nested Teacher Collections ---
      match /exercises/{exerciseId} {
        // Teachers can manage their own exercise bank.
        allow read, delete: if isOwner(teacherId);
        allow create: if isOwner(teacherId) && isValidNewExercise(request.resource.data, teacherId, exerciseId);
        allow update: if isOwner(teacherId) && isExerciseUpdateValid();
      }

      match /tasks/{taskId} {
        // Teachers can manage tasks they have created.
        allow read, delete: if isOwner(teacherId);
        allow create: if isOwner(teacherId) && isValidNewTeacherTask(request.resource.data, teacherId);
        allow update: if isOwner(teacherId) && canTeacherUpdateTask(request.resource.data, resource.data);
      }
    }

    match /students/{studentId} {
      // A student can read their own profile.
      // A teacher can read the profiles of their assigned students.
      allow get: if isOwner(studentId) || (isTeacher() && resource.data.teacherId == request.auth.uid);
      
      // Teachers can query the students collection (client query must filter by teacherId). Admins can also list.
      allow list: if isTeacher() || isAdmin();
      
      // A user can only create, update, or delete their own student profile.
      allow create: if isOwner(studentId) && isValidStudentProfile(request.resource.data, studentId);
      allow update: if isOwner(studentId) && isStudentProfileUpdateValid();
      allow delete: if isOwner(studentId);

      // --- Nested Student Collections ---
      match /tasks/{taskId} {
        // A student can get their own tasks. A teacher can get tasks they authored.
        allow get: if isOwner(studentId) || isTaskAuthor(resource.data);
        
        // A student can list their own tasks.
        allow list: if isOwner(studentId);
        
        // Only a teacher can create a task for a student.
        allow create: if isTeacher() && isValidNewStudentTask(request.resource.data, studentId);
        
        // A student can update their performance data. A teacher can update task metadata.
        allow update: if (isOwner(studentId) && canStudentUpdateTask(request.resource.data, resource.data)) ||
                         canTeacherUpdateTask(request.resource.data, resource.data);
                         
        // Only the authoring teacher can delete a task.
        allow delete: if isTaskAuthor(resource.data);
      }
    }
  }
}
