rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    //  HELPER FUNCTIONS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // The admin is a superuser with a hardcoded, unique UID.
    // This function is the ultimate authority and is checked first in rules.
    function isAdmin() {
      return request.auth.uid == 'yUKh2hnexMdiTd2t9rXEU0SgjPk1';
    }

    function isTeacher() {
      // FIX: Admin is a teacher, but don't hit the DB if we know it's the admin.
      if (isAdmin()) {
        return true;
      }
      return exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isDirector() {
      // FIX: Admin isn't a director. Don't hit the DB for the admin.
      if (isAdmin()) {
          return false;
      }
      return exists(/databases/$(database)/documents/directors/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTaskAuthor(task) {
      return isSignedIn() && request.auth.uid == task.teacherId;
    }
    
    function isStudentUpdatingPerformance() {
      // Rule: Student must be the one the task is assigned to.
      if (request.auth.uid != resource.data.studentId) {
        return false;
      }
      // Rule: Cannot un-complete a task.
      if (resource.data.isCompleted == true && request.resource.data.isCompleted == false) {
        return false;
      }
      // Rule: Students can only update their performance fields, not the core task definition.
      let immutableFields = ['title', 'description', 'dueDate', 'teacherId', 'studentId', 'subject', 'taskType', 'studentName', 'teacherName', 'studentProzilId'];
      return request.resource.data.diff(resource.data).affectedKeys().toSet().intersection(immutableFields.toSet()).size() == 0;
    }

    // =====================================================================
    //  GLOBAL ADMIN RULE
    // =====================================================================
    
    // This single rule grants the administrator unconditional read/write access
    // to the entire database, solving all previous cascading permission errors.
    match /{path=**} {
      allow read, write: if isAdmin();
    }

    // =====================================================================
    //  COLLECTION-SPECIFIC RULES (FOR NON-ADMINS)
    // =====================================================================

    // --- Collection Group Query ---
    // This allows Directors to list all tasks across the entire database for reporting.
    match /{path=**}/tasks/{taskId} {
      allow list: if isDirector();
    }

    // --- Teacher Profiles and Data ---
    match /teachers/{teacherId} {
      allow get: if isSignedIn();
      allow list: if isDirector();
      allow write: if isOwner(teacherId);

      // Subcollection: Teacher's Exercise Bank
      match /exercises/{exerciseId} {
        allow read: if isOwner(teacherId) || isDirector();
        allow write: if isOwner(teacherId);
      }

      // Subcollection: Master copy of tasks created by the teacher.
      match /tasks/{taskId} {
        allow read: if isOwner(teacherId) || isDirector();
        allow create, delete: if isOwner(teacherId);
        allow update: if isOwner(teacherId) || isStudentUpdatingPerformance();
      }
    }

    // --- Student Profiles and Data ---
    match /students/{studentId} {
      allow get: if isOwner(studentId) || (isTeacher() && resource.data.teacherIds.hasAny([request.auth.uid])) || isDirector();
      allow list: if isTeacher(); // Allows teachers to query for students. The client-side query must be secure.
      allow write: if isOwner(studentId);

      // Subcollection: Copy of tasks assigned to the student.
      match /tasks/{taskId} {
        allow get: if isOwner(studentId) || isTaskAuthor(resource.data) || isDirector();
        allow list: if isOwner(studentId);
        allow create: if isTeacher();
        allow update: if isOwner(studentId) || isTaskAuthor(resource.data);
        allow delete: if isTaskAuthor(resource.data);
      }
    }

    // --- Director Profiles ---
    match /directors/{directorId} {
      allow get: if isSignedIn();
      allow list: if false; // Only admin can list directors (handled by global rule).
      allow write: if isOwner(directorId);
    }

    // --- User Invitations ---
    match /invites/{inviteId} {
      // Publicly listable so the signup page can check if an email is invited.
      allow list: if true;
      // No one needs to read a single invite directly.
      allow get: if false;
      // Only admin can create/delete invites (handled by global rule).
      allow write: if isAdmin();
    }
  }
}
